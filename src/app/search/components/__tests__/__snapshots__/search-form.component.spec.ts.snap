            name="hearingType"
            placeholder="All hearing types"
          />
        </pdk-form-group>
      </pdk-form-field>
      <pdk-form-group
        class="govuk-!-margin-bottom-4 pdk-form-group"
        pdk-margin-bottom="4"
      >
        <fieldset
          class="govuk-fieldset"
          pdk-fieldset=""
        >
          <legend
            class="govuk-fieldset__legend govuk-fieldset__legend--s"
            pdk-legend="small"
          >
            Jurisdiction
          </legend>
          <pdk-checkbox
            checkboxtype="small"
            class="govuk-checkboxes govuk-checkboxes--small ng-untouched ng-pristine ng-valid"
            name="sjp"
          >
            <div
              class="govuk-checkboxes__item"
            >
              <input
                class="govuk-checkboxes__input"
                id="pdk-checkbox-GENERATED_ID"
                name="sjp"
                type="checkbox"
                value="true"
