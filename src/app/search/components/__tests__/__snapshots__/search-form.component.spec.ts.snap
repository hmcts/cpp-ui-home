      <fieldset
        class="govuk-fieldset"
        pdk-fieldset=""
      >
        <legend
          class="govuk-!-margin-bottom-0 govuk-fieldset__legend govuk-fieldset__legend--s"
          pdk-legend="small"
          pdk-margin-bottom="0"
