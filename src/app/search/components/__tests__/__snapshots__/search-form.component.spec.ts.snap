                  >
                    <label
                      class="govuk-label govuk-label--s"
                      for="pdk-select-GENERATED_ID"
                    >
                       Sort by date SJP notice served 
                    </label>
                    <pdk-select
                      class="ng-untouched ng-pristine ng-valid"
                      justified=""
                      name="sortBySjpNoticeServed"
                      placeholder="Not applicable"
                    >
                      <select
                        class="govuk-select pdk-select--justified"
                        id="pdk-select-GENERATED_ID"
                        name="sortBySjpNoticeServed"
                      >
                        <option
                          value=""
                        >
                          Not applicable
                        </option>
                        <option
                          value="asc"
                        >
                           Ascending 
                        </option>
                        <option
                          value="desc"
                        >
                           Descending 
                        </option>
                      </select>
                    </pdk-select>
                  </pdk-form-group>
                </pdk-form-field>
              </div>
            </pdk-checkbox-conditional>
          </div>
          <pdk-checkbox
            checkboxtype="small"
            class="govuk-checkboxes govuk-checkboxes--small ng-untouched ng-pristine ng-valid"
            name="magistrateCourt"
          >
            <div
