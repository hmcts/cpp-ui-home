{
  "name": "cpp.ui.home",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "test": "ng test",
    "test-watch": "ng test --watch",
    "lint": "ng lint",
    "tsc": "tsc --noEmit",
    "code:format": "pretty-quick --staged",
    "ci:build": "npm run build:prod",
    "ci:build:prod": "npm run ci:build -- --configuration=production",
    "ci:build:staging": "npm run ci:build -- --configuration=staging",
    "ci:build:test": "npm run ci:build:staging",
    "ci:lint": "mkdirp ./build/lint && npm run lint 1> ./build/lint/tslint-checkstyle-result.xml",
    "ci:test": "ng test --coverage --ci --no-cache",
    "nsp": "exit 0",
    "ci:nsp": "exit 0",
    "jest-clear-cache": "jest --clearCache"
  },
  "husky": {
    "hooks": {
      "pre-commit": "run-s code:format build lint"
    }
  },
  "dependencies": {
    "@angular/animations": "^19.2.15",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.15",
    "@angular/compiler": "^19.2.15",
    "@angular/core": "^19.2.15",
    "@angular/forms": "^19.2.15",
    "@angular/platform-browser": "^19.2.15",
    "@angular/platform-browser-dynamic": "^19.2.15",
    "@angular/router": "^19.2.15",
    "@cpp/application": "^19.0.5",
    "@cpp/core": "^19.0.1",
    "@cpp/pdk": "^19.0.5",
    "@cpp/reference-data": "^19.0.1",
    "@cpp/users-groups": "^19.0.1",
    "@kolkov/angular-editor": "^2.1.0",
    "@ng-select/ng-select": "^14.9.0",
    "@ngrx/effects": "^19.2.1",
    "@ngrx/operators": "^19.2.1",
    "@ngrx/router-store": "^19.2.1",
    "@ngrx/store": "^19.2.1",
    "date-fns": "^1.30.1",
    "husky": "^4.2.5",
    "lodash-es": "^4.17.21",
    "ramda": "^0.26.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-builders/jest": "^19.0.1",
    "@angular-eslint/builder": "19.8.1",
    "@angular-eslint/eslint-plugin": "19.8.1",
    "@angular-eslint/eslint-plugin-template": "19.8.1",
    "@angular-eslint/schematics": "19.8.1",
    "@angular-eslint/template-parser": "19.8.1",
    "@angular/build": "^19.2.17",
    "@angular/cli": "^19.2.17",
    "@angular/compiler-cli": "^19.2.15",
    "@angular/language-service": "^19.2.15",
    "@cpp/testing": "^19.0.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.36.0",
    "@ngrx/store-devtools": "^19.2.1",
    "@types/jest": "^29.4.0",
    "@types/lolex": "^5.1.0",
    "@types/node": "^12.11.1",
    "@types/ramda": "^0.25.51",
    "@types/uuid": "^3.4.5",
    "@typescript-eslint/parser": "^8.44.0",
    "@typescript-eslint/utils": "8.44",
    "eslint": "^9.36.0",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.5.0",
    "jest-jasmine2": "^29.5.0",
    "lolex": "^4.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.4",
    "pretty-quick": "^3.1.3",
    "rxjs-marbles": "^7.0.1",
    "typescript": "~5.8.3",
    "uuid": "^3.3.3"
  }
}
